{
  "name": "shotlist",
  "version": "0.2.0",
  "description": "Repeatable, annotated UI screenshots from declarative recipes. No code per shot.",
  "license": "MIT",
  "author": "Nicola Mustone",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./dist/schema.json",
    "./recipe.schema.json": "./dist/recipe.schema.json",
    "./macro.schema.json": "./dist/macro.schema.json"
  },
  "bin": {
    "shotlist": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/emit-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "keywords": [
    "screenshot",
    "screenshots",
    "playwright",
    "annotate",
    "annotation",
    "ui",
    "automation",
    "visual-regression"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirDarcanos/shotlist.git"
  },
  "homepage": "https://github.com/SirDarcanos/shotlist#readme",
  "bugs": {
    "url": "https://github.com/SirDarcanos/shotlist/issues"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
